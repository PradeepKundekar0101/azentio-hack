APP_ENV=local

# Postgres (DigitalOcean Managed Database, cluster azentio-hack-pg), psycopg 3 driver.
DATABASE_URL=postgresql+psycopg://azentio_app:<password>@<host>:25060/azentio?sslmode=require
# "transaction" only when connecting through DO's PgBouncer pool.
DB_POOL_MODE=session

# DigitalOcean Spaces. The access key is "azentio-hack", limited to read/write on this bucket.
SPACES_REGION=sgp1
SPACES_ENDPOINT_URL=https://sgp1.digitaloceanspaces.com
SPACES_BUCKET=leaklens-files
SPACES_PREFIX=azentio-hack/
SPACES_ACCESS_KEY_ID=
SPACES_SECRET_ACCESS_KEY=

# Shared demo login. Generate the secret with: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
SESSION_SECRET=
DEMO_USERNAME=demo
DEMO_PASSWORD=
# Browsers drop Secure cookies on plain http://localhost in some cases; keep false locally.
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000
